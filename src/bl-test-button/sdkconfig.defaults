# Broadcaster only. No peripheral role, because nothing connects to this
# device — the entire payload is in the advertisement — and no central or
# observer, because it never listens. That is most of NimBLE compiled out.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# Nothing connects, so no connection contexts are needed.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# Same layout as the router: ota_0 at 0x10000, matching what the manifest
# publishes for app.bin. A mismatch there does not fail the flash, it just
# produces a board that never boots.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ESP-IDF validates the partition table against this, not against the fitted
# part, so a 4MB layout fails on a 4MB board until it is declared.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Provisioning happens over the same cable that flashed the board, so stdin
# has to arrive on the USB peripheral rather than on UART0's pins. The button
# has nothing to provision, but the console still answers `hello` — which is
# how the flasher learns the EUI it needs to claim the device.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Sleep between presses.
#
# The board spends essentially all its life waiting for a finger: a press
# lights the radio for ten seconds and everything after that is idle. Without
# this the CPU runs at full clock doing nothing but polling a GPIO, which on
# a coin cell is the whole battery.
#
# Tickless idle is what actually stops the clock — power management alone only
# lets the frequency drop, and a 20ms tick would wake it 50 times a second
# regardless.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_DFS_INIT_AUTO=y

# The radio has to stay up while it is broadcasting, and light sleep would
# take it down mid-advertisement. NimBLE asks for a power lock around its own
# activity, which is what makes the two coexist.
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
