# Build output is committed deliberately — the console fetches it over raw.
# Only local noise is ignored.
.DS_Store
__pycache__/
*.pyc

# ESP-IDF build output. The .bin files that matter are copied into builds/ by
# the workflow and committed there; everything else here is regenerable.
src/*/build/
src/*/sdkconfig
src/*/sdkconfig.old
src/*/managed_components/
src/*/dependencies.lock
